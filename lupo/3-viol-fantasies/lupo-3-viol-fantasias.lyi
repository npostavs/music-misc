\version "2.24.4"
\pointAndClickOff
\language "english"


\header {
    composer =  "Thomas Lupo"
    scomposer =  "T. Lupo"
    title = "Fantasias for 3 Viols"
    encodingsoftware =  "Audiveris 5.11.0"
    encodingdate =  "2026-07-18"
    source = "IMSLP890166-PMLP246169-Lupo-ThreePartFantasias.pdf"
    tagline = ##f
}

\paper {
    print-all-headers = ##f
    % bookTitleMarkup = \markup {}
    % scoreTitleMarkup = \markup \fill-line {
    %   \fromproperty #'header:piece
    %   "" % \fromproperty #'header:composer
    % }
    oddHeaderMarkup = \markup \unless \on-first-page \fill-line {
      ""
      \concat { \tiny { \fromproperty #'header:title ", "
                \fromproperty #'header:scomposer " - "
                \fromproperty #'header:instrument }}
      \if \should-print-page-number
      \concat { \fromproperty #'page:page-number-string
                \fromproperty #'header:page-total-string }
    }
    evenHeaderMarkup = \markup \fill-line {
      \if \should-print-page-number
      \concat { \fromproperty #'page:page-number-string
                \fromproperty #'header:page-total-string }
      \concat { \tiny { \fromproperty #'header:title ", "
                \fromproperty #'header:scomposer " - "
                \fromproperty #'header:instrument }}
      ""
    }
}

\layout {
    \context { \Score
        skipBars = ##t
    }
    \context { \Voice
        \consists "Ambitus_engraver"
    }
}


